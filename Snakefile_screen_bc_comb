with open(inp) as fh:
    for line in fh:
        parts = line.strip().split(chr(9))
        if len(parts) >= 2:
            bc = parts[0].strip().strip(chr(34)).strip(chr(13))
            try:
                cnt = int(parts[1])
            except Exception:
                continue
            if len(bc) == 10 and set(bc) <= set('ACGTN'):
                for _ in range(cnt):
                    print(bc)
PYEOF
        """

