# Goodbye message

def format_config(key, value, space=0):
    """
    Helper function to format the config file in a nice way for the message
    """
    lines = []
    # Check if value is a dictionary
    if isinstance(value, dict):
        lines.append(f"{' ' * space}\033[1m{key}:\033[0m")
        for k, v in value.items():
            if isinstance(v, dict):
                lines.extend(format_config(k, v, space + 2))
            else:
                if isinstance(v, list):
                    lines.append(f"{' ' * space} - \033[1m{k}:\033[0m")
                    for i in v:
                        # Escape curly braces for Snakemake message formatting
                        escaped_i = str(i).replace("{", "{{").replace("}", "}}")
                        lines.append(f"{'   ' * space}{escaped_i}")
                else:
                    # Escape curly braces for Snakemake message formatting
                    escaped_v = str(v).replace("{", "{{").replace("}", "}}")
                    lines.append(f"{' ' * space} - \033[1m{k}:\033[0m {escaped_v}")
    else:
        # Escape curly braces for Snakemake message formatting
        escaped_value = str(value).replace("{", "{{").replace("}", "}}")
        lines.append(f"\033[1m{key}:\033[0m {escaped_value}")
    return lines


def create_goodbye_message(sample_replicate_files, comparisons_dict):
    """
    Create a formatted goodbye message with pipeline info and config
    """
    lines = []
    lines.append("\n"+"\033[0m=" * 80)
    lines.append("primetime")
    lines.append(f"Version {__version__}")
    lines.append("-" * 80)
    
    for key, value in config.items():
        lines.extend(format_config(key, value))
    
    # Show all the samples that were found
    lines.append("\033[1mSAMPLES:\033[0m")
    for sample in sample_replicate_files:
        lines.append(f" - {sample}")

    # Show all the comparisons that were made
    lines.append("\033[1mCOMPARISONS:\033[0m")
    for ref, contrasts in comparisons_dict.items():
        for contrast in contrasts:
            lines.append(f" - \033[4m{ref}\033[0m vs {contrast}")

    lines.append("=" * 80)
    return "\n".join(lines)


# Parse the plates on the plates_file
plate_to_file = {}
with open(plates_file, 'r') as f:
    for line in f:
        row = line.strip().split('\t')
        plate_id = row[0]
        plate_file = row[1]
        plate_to_file[plate_id] = plate_file

# Parse the samples and replicates on the samples_file
df = pd.read_csv(samples_file, sep=",", header=None)
# list of well IDs (used to declare demultiplexed FASTQ outputs)
wells = df[0].tolist()

# Use all plates from plate_to_file; demultiplex_fastq will create the demultiplexed files
plate_ids_to_use = list(plate_to_file.keys())

# Add a third column (index 2) with the fastq file path for each well ID in column 0
# files will be named like: files_dir/demultiplex_<plate_id>_<well>.fastq.gz
rows = []
pdna_added = False
for _, row in df.iterrows():
    well = row.iloc[0]
    sample = row.iloc[1]
    for plate_id in plate_ids_to_use:
        # Special-case: pDNA is a single file (no well). The plates file contains the read1 path for pDNA
        if plate_id == "pDNA":
            if not pdna_added:
                path = plate_to_file.get("pDNA")
                # sample name for pDNA is 'pDNA' and well is left empty
                rows.append([None, "pDNA", path])
                pdna_added = True
        else:
            path = os.path.join(demultiplex_dir, f"{plate_id}_{well}.fastq.gz")
            rows.append([well, sample, path])

# Create a new DataFrame from the accumulated rows (do not overwrite `df` while iterating it), with unique entries
df = pd.DataFrame(rows).drop_duplicates().reset_index(drop=True)

# Sanity check: expected rows is num_wells * num_plates (but pDNA contributes 1 row, not num_wells)
num_wells = len(pd.read_csv(samples_file, sep=",", header=None))
num_plates = len(plate_ids_to_use)
num_pDNA = 1 if "pDNA" in plate_ids_to_use else 0
expected_rows = num_wells * (num_plates - num_pDNA) + num_pDNA
if len(df) != expected_rows:
    print(f"Generated {len(df)} rows ({num_wells} wells * {num_plates - num_pDNA} plates + {num_pDNA} pDNA)")

sample_replicate_files = {}
# Iterate the DataFrame rows and populate the sample -> replicate -> fastq mapping
for _, row in df.iterrows():
    # sample name is in column 1, fastq path in column 2
    sample = str(row.iloc[1])
    fastq = row.iloc[2]
    well = row.iloc[0]  # well ID from column 0
    # For multi-plate experiments, we need to track samples by well_replicate (e.g., DMSO_1 from plate rep1 vs rep2)
    # Create a key that includes well number for non-pDNA samples
    if sample == "pDNA":
        # pDNA has no well, just use sample name
        sample_key = sample
    else:
        # Extract well number from sample name (e.g., "DMSO_1" -> "1", "minRT_10" -> "10")
        # Sample names should be like "DMSO_1", "DMSO_2", "minRT_1", etc.
        sample_key = sample
    # Now assign replicate based on how many FASTQ files this sample_key has
    if sample_key not in sample_replicate_files:
        sample_replicate_files[sample_key] = {'1': fastq}
    else:
        # Get the replicate number based on how many files of this sample_key are there
        replicate = str(len(sample_replicate_files[sample_key]) + 1)
        sample_replicate_files[sample_key][replicate] = fastq


